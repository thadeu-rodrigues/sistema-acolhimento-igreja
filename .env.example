# =========================================
# Variáveis de Ambiente — Exemplo
# Copie este arquivo para .env ou .env.local e configure seus valores
# =========================================

# ----- Banco de Dados PostgreSQL -----
# Formato: postgresql://<USUARIO>:<SENHA>@<HOST>:<PORTA>/<NOME_BANCO>?schema=public
# Exemplo com Docker local:
DATABASE_URL="postgresql://ictaubate:ictaubate_dev@localhost:5432/ictaubate?schema=public"

# ----- Auth.js v5 (NextAuth) -----
# Gere uma chave segura no terminal com: openssl rand -base64 32
AUTH_SECRET="sua_chave_secreta_aqui_gerada_com_openssl"
NEXTAUTH_URL="http://localhost:3000"

# ----- Configurações da Aplicação -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Notificações via Telegram (Opcional) -----
TELEGRAM_BOT_TOKEN="seu_bot_token_aqui"
TELEGRAM_CHAT_ID="seu_chat_id_aqui"

# ----- E-mail via Resend (Opcional) -----
# RESEND_API_KEY=""

