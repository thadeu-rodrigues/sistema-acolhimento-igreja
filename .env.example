# =========================================
# ICTaubaté — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# =========================================

# ----- Banco de Dados -----
# Local (docker-compose.yml):
DATABASE_URL="postgresql://ictaubate:ictaubate_dev@localhost:5432/ictaubate"
# Produção (docker-compose.prod.yml):
# DATABASE_URL="postgresql://ictaubate:SUA_SENHA_FORTE@postgres:5432/ictaubate"

# ----- Auth.js v5 -----
# Gere com: openssl rand -base64 32
AUTH_SECRET="SUBSTITUA_POR_UMA_CHAVE_SEGURA"
NEXTAUTH_URL="http://localhost:3000"

# ----- Notificações (opcional) -----
# E-mail via Resend
RESEND_API_KEY=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
